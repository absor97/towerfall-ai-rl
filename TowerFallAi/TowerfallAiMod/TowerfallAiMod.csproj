<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds TowerfallAiMod.dll with the .NET SDK alone (no Visual Studio):

        dotnet build -c Release

    The mod compiles against the "unsealed" copy of the game that Patcher.exe leaves in
    <game folder>\Patcher\Unsealed, so the game has to be patched once with a released mod first.
    Set TOWERFALL_PATH if the game is not in Steam's default folder.
  -->
  <PropertyGroup>
    <TargetFramework>net40</TargetFramework>
    <AssemblyName>TowerfallAiMod</AssemblyName>
    <RootNamespace>TowerfallAiMod</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <!-- Properties\AssemblyInfo.cs already declares the assembly attributes, with a wildcard version. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>
    <DebugType>full</DebugType>
    <!-- XNA is 32-bit only; the mod itself is AnyCPU and gets loaded by the 32-bit game. -->
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    <TowerFallDir Condition="'$(TOWERFALL_PATH)' != ''">$(TOWERFALL_PATH)</TowerFallDir>
    <TowerFallDir Condition="'$(TowerFallDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\TowerFall</TowerFallDir>
    <XnaGac>$(SystemRoot)\Microsoft.NET\assembly\GAC_32</XnaGac>
    <XnaVersion>v4.0_4.0.0.0__842cf8be1de50553</XnaVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- These belong to the separate Common project and are not part of the mod. -->
    <Compile Remove="Common\KeySemaphore.cs;Common\RemoteConnection.cs;Common\Properties\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Bcl.Async" Version="1.0.168" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <ProjectReference Include="..\PatcherLib\PatcherLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="TowerFall">
      <HintPath>$(TowerFallDir)\Patcher\Unsealed\TowerFall.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework">
      <HintPath>$(XnaGac)\Microsoft.Xna.Framework\$(XnaVersion)\Microsoft.Xna.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Game">
      <HintPath>$(XnaGac)\Microsoft.Xna.Framework.Game\$(XnaVersion)\Microsoft.Xna.Framework.Game.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Graphics">
      <HintPath>$(XnaGac)\Microsoft.Xna.Framework.Graphics\$(XnaVersion)\Microsoft.Xna.Framework.Graphics.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckUnsealedGame" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(TowerFallDir)\Patcher\Unsealed\TowerFall.exe')"
           Text="$(TowerFallDir)\Patcher\Unsealed\TowerFall.exe not found. Run Patcher.exe in the game folder once, or set TOWERFALL_PATH." />
  </Target>
</Project>
